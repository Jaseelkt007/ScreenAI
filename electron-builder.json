{
  "appId": "com.screenai.assistant",
  "productName": "ScreenAI",
  "copyright": "© 2026 Mohammed Jaseel Kunnathodika",
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "files": [
    "main/**/*",
    "renderer/**/*",
    "preload/**/*",
    "assets/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/screenshot-desktop/lib/win32/*.bat",
    "node_modules/screenshot-desktop/lib/win32/*.manifest"
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "assets/icons/icon.png",
    "publisherName": "ScreenAI",
    "sign": null
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] }
    ],
    "icon": "assets/icons/icon.png",
    "category": "public.app-category.utilities",
    "extendInfo": {
      "NSScreenCaptureUsageDescription": "Screen AI Assistant needs screen recording permission to capture selected screen regions for AI analysis."
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true
  }
}
