{
  "name": "screenai",
  "productName": "ScreenAI",
  "version": "2.1.2",
  "description": "ScreenAI — AI-powered screen analysis desktop assistant using Electron and Google Gemini Vision",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "create-icon": "node scripts/create-icon.js",
    "prebuild:win": "node scripts/create-icon.js",
    "prebuild:mac": "node scripts/create-icon.js",
    "prebuild": "node scripts/create-icon.js",
    "build:win": "electron-builder --win -c.win.signAndEditExecutable=false",
    "build:win:full": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build": "electron-builder --win --mac"
  },
  "dependencies": {
    "form-data": "^4.0.5",
    "jimp": "1.6.1",
    "node-fetch": "3.3.2",
    "screenshot-desktop": "^1.15.3"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "author": {
    "name": "Mohammed Jaseel Kunnathodika",
    "url": "https://www.linkedin.com/in/jaseelkt/"
  },
  "homepage": "https://www.linkedin.com/in/jaseelkt/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaseelkt/screenai"
  },
  "license": "Apache-2.0"
}
