# ─────────────────────────────────────────────────────────────────────────────
#  ScreenAI — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
#  Copy this file to .env and fill in your values.
#  The .env file is gitignored and will never be committed.
#
#  Alternatively, enter your API keys through the Settings UI
#  (tray icon → Settings / API Key) — no .env file needed.
#
# ─────────────────────────────────────────────────────────────────────────────


# ── Gemini API Key (required for Gemini models) ───────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here


# ── OpenAI API Key (required only if using GPT-4o / o1 / o3-mini) ────────────
# Get a key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here


# ── Model override (optional) ─────────────────────────────────────────────────
# Default model is gemini-3-flash-preview. Uncomment to override.
#
# Gemini options:
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_MODEL=gemini-2.5-flash
#
# OpenAI options (also requires OPENAI_API_KEY above):
# GEMINI_MODEL=gpt-4o
# GEMINI_MODEL=gpt-4o-mini
# GEMINI_MODEL=o1
# GEMINI_MODEL=o3-mini
