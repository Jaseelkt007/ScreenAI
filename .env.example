# ─────────────────────────────────────────────────────────────────────────────
#  ScreenAI — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────────────────
#
#  API keys are entered through the Settings UI (tray icon → Settings).
#  They are stored securely in the OS user-data directory and never committed.
#
#  This file is for reference only. The app no longer loads a .env file.
#  Power users may set these variables at the OS level if preferred — the app
#  will use them as a fallback if no key has been saved via Settings.
#
# ─────────────────────────────────────────────────────────────────────────────

# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here

# Model override (optional — default: gemini-3.1-flash-lite-preview)
# GEMINI_MODEL=gemini-2.5-flash
